<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Eyelash Style"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:paddingBottom="16dp" />

        <!-- CLASSIC -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Classic"
                android:textSize="20sp"
                android:textColor="#000"
                android:paddingBottom="8dp" />

            <RadioGroup
                android:id="@+id/groupClassic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/classicLight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Light" />

                <RadioButton
                    android:id="@+id/classicMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medium"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp" />

                <RadioButton
                    android:id="@+id/classicHeavy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Heavy" />
            </RadioGroup>
        </LinearLayout>

        <!-- CAT EYES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cat Eyes"
                android:textSize="20sp"
                android:textColor="#000"
                android:paddingBottom="8dp" />

            <RadioGroup
                android:id="@+id/groupCatEyes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/catEyesLight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Light" />

                <RadioButton
                    android:id="@+id/catEyesMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medium"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp" />

                <RadioButton
                    android:id="@+id/catEyesHeavy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Heavy" />
            </RadioGroup>
        </LinearLayout>

        <!-- DOLL EYES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doll Eyes"
                android:textSize="20sp"
                android:textColor="#000"
                android:paddingBottom="8dp" />

            <RadioGroup
                android:id="@+id/groupDollEyes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/dollEyesLight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Light" />

                <RadioButton
                    android:id="@+id/dollEyesMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medium"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp" />

                <RadioButton
                    android:id="@+id/dollEyesHeavy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Heavy" />
            </RadioGroup>
        </LinearLayout>

        <!-- Confirm Button -->
        <Button
            android:id="@+id/btnConfirmEyelash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apply"
            android:textColor="#FFF"
            android:backgroundTint="#E91E63"
            android:layout_marginTop="24dp"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>
