<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Camera preview -->
    <ViewStub
        android:id="@+id/camera_kit_stub_eyelash"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Toolbar -->
    <RelativeLayout
        android:id="@+id/TopToolbar"
        android:layout_width="match_parent"
        android:layout_height="97dp"
        android:background="#66000000"
        android:padding="20dp">

        <!-- Back Button (TOP LEFT) -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:backgroundTint="#00FFFFFF"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />

    </RelativeLayout>

    <!-- Bottom toolbar -->
    <RelativeLayout
        android:id="@+id/layoutEyelashToolbar"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_gravity="bottom"
        android:background="#66000000"
        android:padding="20dp">

        <!-- Camera button (centered) -->
        <ImageButton
            android:id="@+id/btnScreenshot"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:padding="16dp"
            android:background="@drawable/rounded_button_blank"
            android:src="@drawable/ic_camera"
            app:tint="@android:color/white"
            android:layout_centerInParent="true" />

        <!-- Select Filter button (left of center) -->
        <Button
            android:id="@+id/btnSelectFilter"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btnScreenshot"
            android:layout_marginEnd="16dp"
            android:backgroundTint="@color/gray"
            android:padding="12dp"
            android:text="Select Filter"
            android:textColor="@android:color/white" />

    </RelativeLayout>

</FrameLayout>
