<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:paddingHorizontal="20dp"
    android:paddingVertical="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Nail Length Section -->
        <TextView
            android:id="@+id/tvSelectLength"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Nail Length"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/layoutLengths"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnNailShort"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Short"
                android:textAllCaps="false"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/black"
                android:background="@drawable/rounded_button_blank" />

            <Button
                android:id="@+id/btnNailMedium"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Medium"
                android:textAllCaps="false"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/black"
                android:background="@drawable/rounded_button_blank" />

            <Button
                android:id="@+id/btnNailLong"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Long"
                android:textAllCaps="false"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/black"
                android:background="@drawable/rounded_button_blank" />
        </LinearLayout>

        <!-- Color Selection -->
        <TextView
            android:id="@+id/tvSelectColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Color"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginBottom="12dp" />

        <GridLayout
            android:id="@+id/gridColors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="true"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnColorRed"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:backgroundTint="@color/red" />

            <Button
                android:id="@+id/btnColorBlue"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:backgroundTint="@color/blue" />

            <Button
                android:id="@+id/btnColorWhite"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:backgroundTint="@color/white" />

            <Button
                android:id="@+id/btnColorBrown"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:backgroundTint="@color/brown" />

            <Button
                android:id="@+id/btnColorPink"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:backgroundTint="@color/pink" />
        </GridLayout>

        <!-- Nail Polish Toggle -->
        <LinearLayout
            android:id="@+id/layoutNailPolish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="28dp">

            <TextView
                android:id="@+id/tvNailPolish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nail Polish Only"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:fontFamily="@font/poppins_light"
                android:layout_marginEnd="12dp" />

            <Switch
                android:id="@+id/switchNailPolish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSelectSet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Nail Art Set"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginBottom="12dp" />

        <!-- Nail Art Sets -->

        <!-- SHORT -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Short Nail Art Sets"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginBottom="8dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/btnShortSet1"
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:text="Elegant Red"
                    android:background="@drawable/rounded_button_blank"
                    android:layout_marginEnd="8dp"/>

                <Button android:id="@+id/btnShortSet2"
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:text="Nature's Beauty"
                    android:background="@drawable/rounded_button_blank"
                    android:layout_marginEnd="8dp"/>

                <Button android:id="@+id/btnShortSet3"
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:text="White Panda"
                    android:background="@drawable/rounded_button_blank"
                    android:layout_marginEnd="8dp"/>

                <Button android:id="@+id/btnShortSet4"
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:text="Shortcake"
                    android:background="@drawable/rounded_button_blank"
                    android:layout_marginEnd="8dp"/>

                <Button android:id="@+id/btnShortSet5"
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:text="Best Friends"
                    android:background="@drawable/rounded_button_blank"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- MEDIUM -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medium Nail Art Sets"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginBottom="8dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/btnMediumSet1"
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:text="Elegant Red"
                    android:background="@drawable/rounded_button_blank"
                    android:layout_marginEnd="8dp"/>

                <Button android:id="@+id/btnMediumSet2"
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:text="Nature's Beauty"
                    android:background="@drawable/rounded_button_blank"
                    android:layout_marginEnd="8dp"/>

                <Button android:id="@+id/btnMediumSet3"
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:text="White Panda"
                    android:background="@drawable/rounded_button_blank"
                    android:layout_marginEnd="8dp"/>

                <Button android:id="@+id/btnMediumSet4"
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:text="Shortcake"
                    android:background="@drawable/rounded_button_blank"
                    android:layout_marginEnd="8dp"/>

                <Button android:id="@+id/btnMediumSet5"
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:text="Best Friends"
                    android:background="@drawable/rounded_button_blank"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- LONG -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Long Nail Art Sets"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginBottom="8dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:layout_marginBottom="28dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/btnLongSet1"
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:text="Elegant Red"
                    android:background="@drawable/rounded_button_blank"
                    android:layout_marginEnd="8dp"/>

                <Button android:id="@+id/btnLongSet2"
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:text="Nature's Beauty"
                    android:background="@drawable/rounded_button_blank"
                    android:layout_marginEnd="8dp"/>

                <Button android:id="@+id/btnLongSet3"
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:text="White Panda"
                    android:background="@drawable/rounded_button_blank"
                    android:layout_marginEnd="8dp"/>

                <Button android:id="@+id/btnLongSet4"
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:text="Shortcake"
                    android:background="@drawable/rounded_button_blank"
                    android:layout_marginEnd="8dp"/>

                <Button android:id="@+id/btnLongSet5"
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:text="Best Friends"
                    android:background="@drawable/rounded_button_blank"/>
            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>
</ScrollView>
